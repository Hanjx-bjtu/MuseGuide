# MuseGuide 环境变量模板
#
# ⚠️ 用法：复制为 .env 后填入真实值。.env 已被 .gitignore 排除。
# ⚠️ 严禁把真实 Key 写进代码、测试数据或任何被 git 跟踪的文件（ADR-0004）。

# --- LLM（DeepSeek，OpenAI 兼容端点）---
# 留空时系统不会报错，只会走降级路径（规则映射 / 知识库直出）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.7

# --- 嵌入后端：ollama | sentence-transformers | hash ---
# hash 是占位实现，仅用于让检索链路跑通与测试；其检索指标不得写进结论（ADR-0008）
EMBED_BACKEND=hash
EMBED_MODEL=BAAI/bge-small-zh-v1.5
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- 检索参数 ---
TOP_K=5
CANDIDATE_K=20
